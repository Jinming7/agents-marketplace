{
  "name": "ones-marketplace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace @ones-marketplace/frontend",
    "dev:backend": "npm run dev --workspace @ones-marketplace/backend",
    "build": "npm run build --workspace @ones-marketplace/frontend && npm run build --workspace @ones-marketplace/backend",
    "start": "npm run start --workspace @ones-marketplace/backend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @ones-marketplace/db",
    "db:migrate": "npm run db:migrate --workspace @ones-marketplace/db",
    "db:push": "npm run db:push --workspace @ones-marketplace/db",
    "db:studio": "npm run db:studio --workspace @ones-marketplace/db"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}