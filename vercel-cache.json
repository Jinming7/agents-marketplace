# Vercel Cache Configuration
# This file is used by Vercel for build cache optimization

# Cache key patterns
cache:
  # Node modules cache
  - path: node_modules
    key: npm-{{ hashFiles('package-lock.json') }}
    
  # Next.js build cache  
  - path: apps/frontend/.next/cache
    key: next-{{ hashFiles('apps/frontend/**/*.{ts,tsx,js,jsx}') }}
    
  # TypeScript build info
  - path: apps/frontend/.next
    key: tsbuild-{{ hashFiles('tsconfig.json') }}

# Build optimization
build:
  # Enable SWC compiler
  swc: true
  
  # Enable incremental compilation
  incremental: true
  
  # Compression
  compress: true
  
  # Lighthouse CI (optional)
  lighthouse: false
